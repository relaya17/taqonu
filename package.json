{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Atlas Core — engineering memory platform (ArletOS personal instance)",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test e2e/critical-path.spec.ts",
    "test:e2e:product": "playwright test e2e/product-surfaces.spec.ts",
    "test:e2e:security": "playwright test e2e/security.spec.ts",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "test:unit": "vitest run",
    "proof:run": "pnpm --filter @atlas/engineering-loop proof:run",
    "demo:seed": "pnpm --filter @atlas/api exec tsx src/scripts/demo-seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules",
    "turbo": "turbo"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
