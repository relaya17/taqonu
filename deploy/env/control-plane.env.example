# Atlas Control Plane — /etc/atlas/control-plane.env
#
# Copy to /etc/atlas/control-plane.env, fill in real values, then:
#   sudo chown root:atlas /etc/atlas/control-plane.env
#   sudo chmod 0640 /etc/atlas/control-plane.env
#
# NEVER commit a filled-in copy of this file.

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=production

# Default 3100. Loopback only — the reverse proxy is the sole ingress.
CONTROL_PLANE_PORT=3100
HOST=127.0.0.1

# ── Authority tokens (ADR-021 stage 03) ──────────────────────────────────
# Two DISTINCT values. Do not reuse one for both.
#   ATLAS_CONTROL_PLANE_TOKEN       -> authenticates as OPERATOR
#   ATLAS_CONTROL_PLANE_OWNER_TOKEN -> authenticates as OWNER (root authority)
# Generate with: openssl rand -base64 48
ATLAS_CONTROL_PLANE_TOKEN=
ATLAS_CONTROL_PLANE_OWNER_TOKEN=

# ── CORS ─────────────────────────────────────────────────────────────────
# Public origin of apps/web. Used for Access-Control-Allow-Origin.
WEB_ORIGIN=

# ── Canonical audit sync (outbound only) ─────────────────────────────────
# Control Plane pushes its audit entries into the API hash-chain, which is the
# system of record. Outbound HTTPS only — requires no inbound firewall rule.
# Set ATLAS_CP_AUDIT_SYNC=0 to disable.
ATLAS_API_URL=
ATLAS_CP_AUDIT_SYNC=1
