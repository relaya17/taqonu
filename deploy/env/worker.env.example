# Atlas Worker — /etc/atlas/worker.env
#
# Copy to /etc/atlas/worker.env, fill in real values, then:
#   sudo chown root:atlas /etc/atlas/worker.env
#   sudo chmod 0640 /etc/atlas/worker.env
#
# NEVER commit a filled-in copy of this file.
#
# The worker calls loadServerEnv() from @atlas/config. With NODE_ENV=production,
# assertProductionSecrets() hard-fails startup unless every value below is set,
# so the worker needs the full server env even though it serves no HTTP.

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
APP_NAME=
PRODUCT_CODENAME=

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Crypto (32+ characters each; generate with: openssl rand -base64 48) ──
ENCRYPTION_KEY=
COOKIE_SECRET=

# ── Durable queue ────────────────────────────────────────────────────────
# Kept outside the git checkout so redeploys never clobber in-flight jobs.
# Must sit under the unit's ReadWritePaths.
ATLAS_QUEUE_PATH=/var/lib/atlas/worker-queue.json
ATLAS_REPO_ROOT=/opt/atlas

# KNOWN LIMITATION — read docs/deployment/private-plane.md before expecting work.
# enqueue() in apps/worker/src/index.ts is exported but called only by that
# module's own tests. apps/api never calls it, and on Vercel the API runs on an
# ephemeral filesystem that cannot share this queue file. The worker will start,
# recover jobs across restarts, and then log worker_idle indefinitely until a
# shared producer exists. That gap is out of scope for this migration.
