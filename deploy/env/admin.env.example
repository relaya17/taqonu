# Atlas Owner Admin — /etc/atlas/admin.env
#
# Copy to /etc/atlas/admin.env, fill in real values, then:
#   sudo chown root:atlas /etc/atlas/admin.env
#   sudo chmod 0640 /etc/atlas/admin.env
#
# NEVER commit a filled-in copy of this file.

# ── Runtime ──────────────────────────────────────────────────────────────
# With NODE_ENV=production and no token set, apps/admin returns 503 by design
# (admin-auth.ts). The token below is therefore mandatory in production.
NODE_ENV=production

# Default 3200. Loopback only — nginx on the Tailscale IP is the sole ingress.
ADMIN_PORT=3200
HOST=127.0.0.1

# ── Control Plane link ───────────────────────────────────────────────────
# Same host, so this stays loopback traffic that never leaves the VM.
ATLAS_CONTROL_PLANE_URL=http://127.0.0.1:3100

# ── Shared operator token ────────────────────────────────────────────────
# MUST equal ATLAS_CONTROL_PLANE_TOKEN in /etc/atlas/control-plane.env.
#
# This one variable does double duty in apps/admin:
#   outbound — server.ts sends it to the Control Plane
#   inbound  — admin-auth.ts requires it on requests reaching Admin
# The nginx snippet injects the inbound header so a browser can reach the UI.
ATLAS_CONTROL_PLANE_TOKEN=
