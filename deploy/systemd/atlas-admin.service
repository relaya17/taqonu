[Unit]
Description=Atlas Admin platform supervisor (ADR-021 ADMIN surface, :3200)
Documentation=file:///opt/atlas/docs/deployment/private-plane.md
# Admin renders an error page when the Control Plane is down, so ordering is a
# soft hint rather than a hard Requires=.
After=network-online.target atlas-control-plane.service
Wants=network-online.target

[Service]
Type=simple
User=atlas
Group=atlas
WorkingDirectory=/opt/atlas/apps/admin
EnvironmentFile=/etc/atlas/admin.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atlas-admin

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/atlas

[Install]
WantedBy=multi-user.target
