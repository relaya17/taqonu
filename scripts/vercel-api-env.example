# עותק ל: apps/api/.env.vercel  (gitignored — תיקיית שרת בלבד)
#
# Key                         | Value (מה לשים)
# --------------------------- | -----------------------------------------------
# DATABASE_URL                | מחרוזת Postgres של Supabase (Settings → Database → URI)
# SUPABASE_URL                | Project URL — https://xxxxx.supabase.co
# SUPABASE_ANON_KEY           | publishable / anon key
# SUPABASE_SERVICE_ROLE_KEY   | secret / service_role key
# ENCRYPTION_KEY              | לפחות 32 תווים אקראיים
# COOKIE_SECRET               | לפחות 32 תווים אקראיים
# WEB_ORIGIN                  | https://taqonu-web.vercel.app
# NODE_ENV                    | production

DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=
COOKIE_SECRET=
WEB_ORIGIN=https://taqonu-web.vercel.app
NODE_ENV=production
