{
  "name": "@atlas/engineering-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint src",
    "test": "vitest run",
    "proof:run": "tsx src/cli-proof.ts"
  },
  "dependencies": {
    "@atlas/code-intelligence": "workspace:*",
    "@atlas/experts": "workspace:*",
    "@atlas/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
