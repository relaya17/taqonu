NODE_ENV=development
APP_NAME=ArletOS
PRODUCT_CODENAME=Atlas
LOG_LEVEL=info

# Server-only — copy to apps/api/.env (gitignored). Never put these in apps/web.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Lab placeholders — production refuses these exact example values.
ENCRYPTION_KEY=12345678901234567890123456789012
COOKIE_SECRET=12345678901234567890123456789012

API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Parent folder of local apps (defaults to sibling of this monorepo in development)
# ATLAS_LOCAL_REPOS_ROOT=C:\Users\User\Desktop\game
# ATLAS_GOLDEN_PROJECT_ROOT=
# ATLAS_GOLDEN_PROJECT_SLUG=brokeros

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_NAME=
# After enabling checks:write on the GitHub App, re-install / accept permission update
# so Atlas can post "Atlas Truth" Check Runs on push/PR webhooks.

ATLAS_PLAN=free
ATLAS_ADMIN_EMAIL=
# Atlas Owner (Control Plane). Never grantable via /admin/users.
ATLAS_OWNER_EMAIL=
# Comma-separated Control Plane operators. Never grantable via UI.
# ATLAS_OPERATOR_EMAILS=
# Required in production for apps/control-plane :3100 (except GET /api/v1/status).
# ATLAS_CONTROL_PLANE_TOKEN=
# Optional: forward selected domain events to the Control API (apps/admin talks to this).
# ATLAS_CONTROL_PLANE_URL=http://127.0.0.1:3100
# ATLAS_API_URL=http://localhost:4000

# Optional replica directory for canonical audit restore drills.
# Unset → local drill only (offsite: false). Object-store credentials remain
# an Owner deployment decision; this path is still the same NDJSON SoR.
# ATLAS_OFFSITE_BACKUP_DIR=

# Optional cron shared secret for GET/POST /api/v1/knowledge/refresh. Without it, refresh requires a signed-in user.
# CRON_SECRET=
# ATLAS_CRON_SECRET=

LLM_PROVIDER=echo
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
OPENAI_API_KEY=

REDIS_URL=
SENTRY_DSN=
