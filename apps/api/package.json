{
  "name": "@atlas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "bundle:vercel": "node scripts/bundle-vercel.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint src"
  },
  "dependencies": {
    "@atlas/agent-core": "workspace:*",
    "@atlas/code-intelligence": "workspace:*",
    "@atlas/config": "workspace:*",
    "@atlas/database": "workspace:*",
    "@atlas/embeddings": "workspace:*",
    "@atlas/engineering-loop": "workspace:*",
    "@atlas/experts": "workspace:*",
    "@atlas/integrations-github": "workspace:*",
    "@atlas/integrations-local": "workspace:*",
    "@atlas/integrations-mongodb": "workspace:*",
    "@atlas/integrations-render": "workspace:*",
    "@atlas/integrations-supabase": "workspace:*",
    "@atlas/integrations-vercel": "workspace:*",
    "@atlas/integrations-cloudflare": "workspace:*",
    "@atlas/knowledge": "workspace:*",
    "@atlas/observer": "workspace:*",
    "@atlas/observability": "workspace:*",
    "@atlas/qa-core": "workspace:*",
    "@atlas/shared": "workspace:*",
    "@atlas/state": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
