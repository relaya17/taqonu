{
  "name": "@atlas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "bundle:vercel": "node scripts/bundle-vercel.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint src"
  },
  "dependencies": {
    "@atlas/agent-core": "*",
    "@atlas/code-intelligence": "*",
    "@atlas/config": "*",
    "@atlas/database": "*",
    "@atlas/embeddings": "*",
    "@atlas/engineering-loop": "*",
    "@atlas/experts": "*",
    "@atlas/integrations-cloudflare": "*",
    "@atlas/integrations-github": "*",
    "@atlas/integrations-local": "*",
    "@atlas/integrations-mongodb": "*",
    "@atlas/integrations-render": "*",
    "@atlas/integrations-supabase": "*",
    "@atlas/integrations-vercel": "*",
    "@atlas/knowledge": "*",
    "@atlas/observability": "*",
    "@atlas/observer": "*",
    "@atlas/qa-core": "*",
    "@atlas/shared": "*",
    "@atlas/state": "*",
    "@atlas/system-model": "*",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "otplib": "^13.4.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
