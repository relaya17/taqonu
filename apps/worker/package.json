{
  "name": "@atlas/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint src"
  },
  "dependencies": {
    "@atlas/config": "workspace:*",
    "@atlas/integrations-github": "workspace:*",
    "@atlas/observability": "workspace:*",
    "@atlas/shared": "workspace:*",
    "@atlas/state": "workspace:*",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
