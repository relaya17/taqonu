{
  "name": "@atlas/control-plane",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "description": "Atlas Control Plane — governance, oversight, and AI agent management surface",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "bundle:vercel": "node scripts/bundle-vercel.mjs",
    "start": "node dist/server.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.19.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "@atlas/shared": "workspace:*",
    "@atlas/integrations-civio": "workspace:*"
  }
}
