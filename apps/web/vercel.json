{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && ./node_modules/.bin/turbo run build --filter=@atlas/web...",
  "env": {
    "TURBO_TEAM": "",
    "TURBO_REMOTE_ONLY": "true",
    "NEXT_PUBLIC_DEMO_LOGIN_ENABLED": "0",
    "NEXT_PUBLIC_API_PROXY": "1",
    "API_PROXY_TARGET": "https://taqonu-api.vercel.app"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_PROXY": "1",
      "API_PROXY_TARGET": "https://taqonu-api.vercel.app"
    }
  }
}
