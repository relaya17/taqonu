{
  "name": "@atlas/admin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "description": "Atlas Admin — platform supervisor over Control and Studio",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "bundle:vercel": "node scripts/bundle-vercel.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@atlas/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
