NODE_ENV=development
APP_NAME=ArletOS
PRODUCT_CODENAME=Atlas
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

ENCRYPTION_KEY=12345678901234567890123456789012
COOKIE_SECRET=12345678901234567890123456789012

API_PORT=4000
WEB_ORIGIN=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=ArletOS
NEXT_PUBLIC_PRODUCT_CODENAME=Atlas

# GitHub App (production install path — docs/adr/ADR-003-github-app.md)
# App ID from the App's "About" page (Settings → Developer settings → GitHub Apps)
GITHUB_APP_ID=
# PEM private key downloaded from the App settings page. Used to sign RS256 JWTs
# (packages/integrations/github/src/app-auth.ts) that are exchanged for short-lived
# installation access tokens. May be pasted with literal \n escapes (single env-var
# line) — normalizeGithubPrivateKey() restores real newlines before signing.
GITHUB_PRIVATE_KEY=
# Shared secret configured on the App's Webhook page; verifies X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=
# App slug (from https://github.com/apps/<slug>) used to build the install URL
# https://github.com/apps/<slug>/installations/new. Falls back to a slugified
# GITHUB_APP_NAME if unset. Required for GET /api/v1/github/install to work.
GITHUB_APP_SLUG=
GITHUB_APP_NAME=

# Freemium cloud (ADR-011) — local projects unlimited; cloud slots gated
# ATLAS_PLAN=free|pro
ATLAS_PLAN=free
# ATLAS_CLOUD_PROJECT_LIMIT=3
# ATLAS_OWNER_ID=00000000-0000-4000-8000-000000000001
# First matching email becomes admin (also: first registered user is admin)
ATLAS_ADMIN_EMAIL=

# Hybrid RAG / pgvector (optional dual-write — file corpus always kept)
# Apply: packages/database/migrations/20260812010000_knowledge_embeddings.sql
#   (also under supabase/migrations/). Live when SUPABASE_SERVICE_ROLE_KEY is not replace-me.
# DATABASE_URL hosts Postgres+pgvector; SUPABASE_* is the dual-write/retrieval client.
# Offline fallback: .atlas/knowledge/corpus.json (+ optional ATLAS_KNOWLEDGE_CORPUS_PATH)
# ATLAS_KNOWLEDGE_CORPUS_PATH=

# Persistence durability (Theme #25 MVP — local store + optional cloud)
# Primary: .atlas/store.json (override path below). Atomic temp→rename + sibling .bak on every flush.
# ATLAS_STORE_PATH=
# Optional heartbeat snapshots under .atlas/store-backups/ (ms between copies; 0/unset = off)
# ATLAS_STORE_BACKUP_INTERVAL_MS=300000
# ATLAS_STORE_BACKUP_KEEP=5
# ATLAS_SKIP_STORE_PERSIST=1  # tests only — disables disk flush
# When local store is empty and SUPABASE_* is live, API startup hydrates projects/memories/decisions/account_plans.

# Stripe Checkout (optional) — unset = staging stub; set secret for live Checkout
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional Price IDs (else dynamic price_data): STRIPE_PRICE_STARTER|GROWTH|SCALE|PRO
# When STRIPE_PRICE_PRO is set, plan-only checkout uses mode=subscription
# STRIPE_SUCCESS_URL=http://localhost:3000/settings/billing?checkout=success
# STRIPE_CANCEL_URL=http://localhost:3000/settings/billing?checkout=canceled
# Forward webhooks to: POST /api/v1/billing/stripe/webhook
#   (checkout.session.completed · customer.subscription.updated · customer.subscription.deleted)


# Atlas 1.1 — Golden Project (BrokerOS) + evals
# Prefer real BrokerOS; if unset/missing, Atlas falls back to fixtures/golden-brokeros
# ATLAS_GOLDEN_PROJECT_ROOT=C:\Users\User\Desktop\game\brokerOS-main
# ATLAS_GOLDEN_PROJECT_SLUG=brokeros
# ATLAS_EVALS_ROOT=
# Run golden Proof 1.1 (gates A–F): pnpm proof:run  ·  POST /api/v1/proof/run  ·  /he/proof
# LOW AUTO_FIX only — still needs signed-in WRITE session; HIGH/CRITICAL never auto-apply
# ATLAS_AUTO_APPLY_LOW=false


# AI — free by default (no paid OpenAI required)
# LLM_PROVIDER: echo | ollama | groq | openai
LLM_PROVIDER=echo
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

REDIS_URL=
SENTRY_DSN=
