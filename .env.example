NODE_ENV=development
APP_NAME=ArletOS
PRODUCT_CODENAME=Atlas
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

ENCRYPTION_KEY=12345678901234567890123456789012
COOKIE_SECRET=12345678901234567890123456789012

API_PORT=4000
WEB_ORIGIN=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=ArletOS
NEXT_PUBLIC_PRODUCT_CODENAME=Atlas

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Freemium cloud (ADR-011) — local projects unlimited; cloud slots gated
# ATLAS_PLAN=free|pro
ATLAS_PLAN=free
# ATLAS_CLOUD_PROJECT_LIMIT=3
# ATLAS_OWNER_ID=00000000-0000-4000-8000-000000000001
# First matching email becomes admin (also: first registered user is admin)
ATLAS_ADMIN_EMAIL=

# Stripe Checkout (optional) — unset = staging stub; set secret for live Checkout
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional Price IDs (else dynamic price_data): STRIPE_PRICE_STARTER|GROWTH|SCALE|PRO
# STRIPE_SUCCESS_URL=http://localhost:3000/settings/billing?checkout=success
# STRIPE_CANCEL_URL=http://localhost:3000/settings/billing?checkout=canceled


# Atlas 1.1 — Golden Project (BrokerOS) + evals
# ATLAS_GOLDEN_PROJECT_ROOT=C:\Users\User\Desktop\game\brokerOS-main
# ATLAS_GOLDEN_PROJECT_SLUG=brokeros
# ATLAS_EVALS_ROOT=


# AI — free by default (no paid OpenAI required)
# LLM_PROVIDER: echo | ollama | groq | openai
LLM_PROVIDER=echo
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

REDIS_URL=
SENTRY_DSN=
